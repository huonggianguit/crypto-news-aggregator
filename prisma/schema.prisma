// prisma/schema.prismanop

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Category {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  
  // Tên hiển thị của Sub-tab (Vd: Tin tức BTC)
  name      String   
  
  // Đây là KHOÁ. Mọi bài viết sẽ bám theo cái này.
  //  để @unique để đảm bảo không có 2 mục trùng link.
  slug      String   @unique 
  
  // Đây là Main Tab.
  groupName String?  
  posts     Post[]
}

// Bảng Bài viết
model Post {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  slug      String   @unique // Link bài viết
  title     String
  description   String?  // Mô tả ngắn
  content   String?  // Nội dung HTML 
  main_img String
  image Json?  // Link ảnh
  toc       Json?
  source    String?  // Nguồn crawl (vnexpress, tuoitre, tapchibitcoin)
  categoryId String   @db.ObjectId
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId]) // Tìm bài viết theo danh mục cực nhanh
  @@index([createdAt])  // Sort bài viết mới nhất cực nhanh
}

// Bảng lưu ảnh từ Unsplash (tránh trùng lặp)
model UnsplashImage {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  unsplashId      String   @unique // ID ảnh từ Unsplash
  imageUrl        String   // URL ảnh full
  thumbnailUrl    String   // URL thumbnail
  photographer    String   // Tên photographer
  photographerUrl String   // Link profile
  keywordUsed     String   // Từ khóa đã search
  articleId       String?  @db.ObjectId // Bài viết sử dụng (optional)
  position        String   // 'title', 'heading', 'content'
  blurHash        String?  // Cho placeholder
  createdAt       DateTime @default(now())
  
  @@index([articleId])
}

// Bảng Văn bản pháp luật
model LegalDocument {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  slug             String   @unique // Link văn bản
  title            String   // Tên văn bản pháp luật
  summary          String?  // Tóm tắt ngắn
  content          String?  // Nội dung HTML
  lawNumber        String?  // Số hiệu văn bản
  issuingAgency    String?  // Cơ quan ban hành
  promulgationDate DateTime? // Ngày ban hành
  effectiveDate    DateTime? // Ngày có hiệu lực
  attachmentUrl    String?  // URL tập tin đính kèm

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([lawNumber])
  @@index([createdAt])
}

// Bảng lưu bài báo crawl (staging trước khi xử lý)
model CrawlArticle {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  sourceUrl      String   @unique // URL gốc bài báo
  title          String   // Tiêu đề gốc
  content        String   // Nội dung HTML gốc
  author         String?  // Tác giả
  publishedDate  DateTime? // Ngày xuất bản
  source         String   // Nguồn: vnexpress, tuoitre, ...
  checksum       String?  // Hash nội dung để detect changes
  
  // Metadata
  mainImage      String?  // Link ảnh chính
  description    String?  // Mô tả/excerpt
  tags           Json?    // Tags từ nguồn
  
  // Trạng thái xử lý
  status         String   @default("pending") // pending, processed, rejected
  
  lastFetchedAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([source])
  @@index([status])
  @@index([publishedDate])
  @@index([lastFetchedAt])
}

// Bảng nguồn tin (Source management)
model Source {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  
  // Thông tin cơ bản
  name          String   // Tên nguồn (VNExpress, TuoiTre, CoinDesk...)
  domain        String   @unique // Domain chính (vnexpress.net)
  baseUrl       String   // URL base để crawl
  
  // Cấu hình selector
  selectors     Json     // { title, content, author, date, mainImage }
  
  // Tình trạng
  isActive      Boolean  @default(true)
  lastCrawlAt   DateTime?
  totalCrawled  Int      @default(0)
  failCount     Int      @default(0) // Số lần crawl lỗi liên tiếp
  
  // Metadata
  language      String   @default("vi") // vi, en
  country       String?  // VN, US
  category      String?  // crypto, tech, finance
  priority      Int      @default(1) // 1-5 (5 cao nhất)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([isActive])
  @@index([priority])
}

// Bảng log hệ thống
model SystemLog {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  
  // Loại log
  level         String   // info, warn, error, debug
  module        String   // crawler, ai_writer, publisher, scheduler
  action        String   // crawl_start, rewrite_success, publish_failed...
  
  // Nội dung
  message       String
  details       Json?    // Chi tiết thêm (object, error stack...)
  
  // Context
  articleId     String?  @db.ObjectId // ID bài viết liên quan
  sourceUrl     String?  // URL liên quan
  userId        String?  // User trigger (nếu có)
  
  // Metrics
  duration      Int?     // Thời gian xử lý (ms)
  memoryUsage   Float?   // MB
  
  timestamp     DateTime @default(now())
  
  @@index([level])
  @@index([module])
  @@index([timestamp])
}
